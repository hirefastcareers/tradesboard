# Copy to .env.local for local testing.
# With DEMO_MODE=true (or no real DATABASE_URL), the app uses fake
# candidates and demo logins — no Neon required.

DEMO_MODE=true

# Leave unset / placeholder so demo mode stays on
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tradesboard-demo-secret-not-for-real-auth-use-32chars

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo sign-in (when DEMO_MODE=true):
#   employer@demo.local / password123
#   candidate@demo.local / password123
